{
  "name": "wescomm-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "prisma generate && tsc",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node dist/tests/run-tests.js",
    "test:ci": "npm run typecheck && npm test",
    "test:paymongo:db": "npm run build && node scripts/test-paymongo-isolated-database.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate:baseline:existing": "node scripts/verify-existing-database-baseline.mjs && prisma migrate resolve --applied 0_init",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:verify": "node scripts/verify-existing-database-baseline.mjs --after-deploy && prisma migrate status",
    "prisma:migrate:verify:ci": "node scripts/verify-existing-database-baseline.mjs --after-deploy --allow-missing-supabase-auth && prisma migrate status",
    "prisma:studio": "prisma studio",
    "prisma:pull": "prisma db pull",
    "push:keys": "web-push generate-vapid-keys",
    "security:encrypt-existing": "tsx src/scripts/encrypt-existing-sensitive-data.ts",
    "seed:wup-catalog": "tsx src/scripts/seed-new-uniform-products.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.108.2",
    "@types/web-push": "^3.6.4",
    "@vercel/functions": "^3.9.5",
    "ai": "^7.0.65",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
