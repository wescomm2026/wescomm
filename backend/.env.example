PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
# Required allowlist. Blank values fail startup; "*" is development-only and
# is rejected in production.
AUTH_ALLOWED_EMAIL_DOMAIN=wesleyan.edu.ph
AUTH_ALLOWED_AUTH_PROVIDERS=email
# Verified Supabase JWT amr methods. Password is always rejected.
AUTH_ALLOWED_AUTH_METHODS=otp,magiclink,email/signup,token_refresh
AUTH_ENABLE_DEV_LOGIN=false
AUTH_DEV_LOGIN_EMAILS=student@wesleyan.edu.ph,staff@wesleyan.edu.ph,admin@wesleyan.edu.ph
# Production:
AUTH_ALLOWED_EMAIL_DOMAINS=wesleyan.edu.ph
# Local or isolated Vercel Preview/QA only. Never enable in Production.
# AUTH_ENABLE_DEV_LOGIN=true
# Server-only; provision privately; never commit. Minimum 12 characters.
# AUTH_DEV_LOGIN_PASSWORD=

# Temporary public Production staff testing only. Keep false by default.
# Enable both frontend/backend flags together for at most 24 hours. The
# server-only password must be a new Sensitive secret of at least 20 characters.
AUTH_ENABLE_TEMP_PRODUCTION_STAFF_LOGIN=false
# AUTH_TEMP_PRODUCTION_STAFF_LOGIN_PASSWORD=
# AUTH_TEMP_PRODUCTION_STAFF_LOGIN_EXPIRES_AT=
NEXT_PUBLIC_ENABLE_TEMP_PRODUCTION_STAFF_LOGIN=false
# NEXT_PUBLIC_TEMP_PRODUCTION_STAFF_LOGIN_EXPIRES_AT=

# Revocable HttpOnly browser sessions. Seven days, maximum five active devices.
AUTH_SESSION_TTL_HOURS=168
AUTH_SESSION_MAX_PER_USER=5

# Versioned AES-256-GCM keys. Generate a 32-byte Base64 key; never expose it to the frontend.
# Keep an old version in this list during key rotation until existing data is re-encrypted.
DATA_ENCRYPTION_CURRENT_VERSION=v1
# DATA_ENCRYPTION_KEYS=v1:YOUR_32_BYTE_BASE64_KEY

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Runtime: Supavisor transaction pooler, port 6543. Keep pgbouncer=true for
# Prisma. Vercel adds conservative connection/pool timeouts when they are absent.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=require
# Administrative operations only: session pooler/direct endpoint on port 5432.
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require

# Web Push phone/browser notifications.
# Generate with: npm run push:keys
VAPID_PUBLIC_KEY=YOUR_GENERATED_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_GENERATED_PRIVATE_KEY
VAPID_SUBJECT=mailto:wescomm@wesleyan.edu.ph

# WesBot uses deterministic, database-grounded responses whenever enabled.
# Semantic routing is deterministic-first. `shadow` records semantic decisions
# without changing replies; `active` uses the classifier for ambiguous input.
# AI rewrites remain separately disabled so a semantic reply needs at most one
# model call. Enable AI Gateway in Vercel and use OIDC; never expose a gateway
# key to the frontend.
WESBOT_ENABLED=false
WESBOT_AI_ENABLED=false
WESBOT_AI_REWRITE_ENABLED=false
WESBOT_SEMANTIC_MODE=off
WESBOT_AI_TIMEOUT_MS=5000
WESBOT_MODEL=openai/gpt-5.6-luna
# AI_GATEWAY_API_KEY=

# PayMongo Hosted Checkout v2. PAYMONGO_ENABLED controls only new checkout
# sessions; keep the webhook secret configured so earlier sessions can still
# be confirmed after the checkout kill switch is turned off. Never expose
# either secret to the frontend.
PAYMONGO_ENABLED=false
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_LIVEMODE=false
# Local safety window. Expired/abandoned sessions are reconciled and then
# expired at PayMongo by the maintenance endpoint.
PAYMONGO_CHECKOUT_TTL_MINUTES=30
# Random server-only bearer token used by the hourly external maintenance job.
# Required whenever PayMongo is enabled in Production. Generate at least 32
# random characters; never prefix it with NEXT_PUBLIC_.
PAYMENT_MAINTENANCE_SECRET=
# Optional approved frontend origin used for success/cancel return pages.
# Defaults to FRONTEND_ORIGIN when blank.
PAYMONGO_RETURN_ORIGIN=
