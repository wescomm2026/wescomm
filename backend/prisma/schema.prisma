generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AppRole {
  STUDENT
  STAFF
  ADMIN

  @@map("app_role")
}

enum ProductStatus {
  IN_STOCK
  RESTOCK_SOON
  OUT_OF_STOCK
  ON_SALE

  @@map("product_status")
}

enum ProductSaleMode {
  SIMPLE
  CLOTH_ONLY
  OPTIONS

  @@map("product_sale_mode")
}

enum InventoryMovementType {
  RESTOCK
  SALE
  RESERVATION_HOLD
  RESERVATION_CANCEL
  RESERVATION_NO_SHOW
  ADJUSTMENT

  @@map("inventory_movement_type")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("reservation_status")
}

enum StudentOffenseType {
  NO_SHOW
  LATE_CANCELLATION
  RESERVATION_SPAM

  @@map("student_offense_type")
}

enum StudentOffenseStatus {
  ACTIVE
  OVERTURNED

  @@map("student_offense_status")
}

enum RestrictionStatus {
  ACTIVE
  EXPIRED
  LIFTED

  @@map("restriction_status")
}

enum RestrictionSource {
  AUTOMATIC
  MANUAL

  @@map("restriction_source")
}

enum PickupReviewStatus {
  NONE
  NEEDS_REVIEW
  RESCHEDULED
  WAIVED

  @@map("pickup_review_status")
}

enum ReservationScheduleChangeSource {
  MANUAL
  SYSTEM_CLOSURE

  @@map("reservation_schedule_change_source")
}

enum PaymentMethod {
  PAY_AT_COMMISSARY
  E_WALLET_AT_PICKUP
  CASH
  GCASH
  PAYMONGO_GCASH

  @@map("payment_method")
}

enum OnlinePaymentStatus {
  INITIALIZING
  AWAITING_PAYMENT
  PAID
  EXPIRED
  CANCELLED
  REFUND_REVIEW_REQUIRED
  PARTIALLY_REFUNDED
  REFUNDED

  @@map("online_payment_status")
}

enum OnlinePaymentAttemptStatus {
  CREATING
  CREATE_UNKNOWN
  ACTIVE
  EXPIRY_REQUESTED
  EXPIRED
  PAID
  FAILED
  ABANDONED
  MANUAL_REVIEW_REQUIRED

  @@map("online_payment_attempt_status")
}

enum PaymongoWebhookEventStatus {
  PROCESSED
  IGNORED
  REJECTED

  @@map("paymongo_webhook_event_status")
}

enum ReceiptStatus {
  PENDING
  VERIFIED
  VOIDED

  @@map("receipt_status")
}

enum NotificationType {
  RESERVATION
  RECEIPT
  PAYMENT
  LOW_STOCK
  BACK_IN_STOCK
  MESSAGE
  SYSTEM

  @@map("notification_type")
}

enum ConversationStatus {
  OPEN
  RESOLVED

  @@map("conversation_status")
}

enum ConversationMode {
  BOT_ACTIVE
  WAITING_FOR_STAFF
  STAFF_ACTIVE
  RESOLVED

  @@map("conversation_mode")
}

enum ConversationMessageSenderType {
  STUDENT
  BOT
  STAFF
  SYSTEM

  @@map("conversation_message_sender_type")
}

model Profile {
  id                    String                      @id @db.Uuid
  fullName              String                      @default("") @map("full_name")
  email                 String                      @unique
  studentNumber         String?                     @unique @map("student_number")
  phone                 String?
  department            String?
  address               String?
  role                  AppRole                     @default(STUDENT)
  avatarUrl             String?                     @map("avatar_url")
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                    @default(now()) @map("updated_at") @db.Timestamptz(6)
  inventoryMovements    InventoryMovement[]         @relation("InventoryPerformedBy")
  reservations          Reservation[]               @relation("StudentReservations")
  receipts              Receipt[]                   @relation("StudentReceipts")
  issuedReceipts        Receipt[]                   @relation("IssuedReceipts")
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  studentConversations  Conversation[]              @relation("StudentConversations")
  assignedConversations Conversation[]              @relation("AssignedStaffConversations")
  sentMessages          ConversationMessage[]       @relation("MessageSender")
  updatedFaqs           Faq[]                       @relation("FaqUpdatedBy")
  updatedSettings       AppSetting[]                @relation("SettingUpdatedBy")
  studentOffenses       StudentOffense[]            @relation("StudentOffenses")
  confirmedOffenses     StudentOffense[]            @relation("ConfirmedOffenses")
  overturnedOffenses    StudentOffense[]            @relation("OverturnedOffenses")
  restrictions          AccountRestriction[]        @relation("StudentRestrictions")
  createdRestrictions   AccountRestriction[]        @relation("CreatedRestrictions")
  liftedRestrictions    AccountRestriction[]        @relation("LiftedRestrictions")
  reservationRequests   ReservationIdempotencyKey[] @relation("StudentReservationRequests")
  authSessions          AuthSession[]
  wishlistItems         WishlistItem[]
  auditLogs             AuditLog[]                  @relation("AuditActor")
  realtimeEvents        RealtimeEvent[]             @relation("RealtimeAudienceUser")
  createdPickupPolicies PickupPolicyVersion[]       @relation("PickupPolicyCreatedBy")
  pickupScheduleChanges ReservationScheduleChange[] @relation("PickupScheduleChangedBy")
  messageEdits          ConversationMessageRevision[] @relation("MessageRevisionEditor")
  deletedConversations  Conversation[]                @relation("ConversationDeletedBy")
  conversationPurges    ConversationPurgeRecord[]     @relation("ConversationPurgedBy")
  policyAcceptances     PolicyAcceptance[]

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([role, createdAt(sort: Desc), id(sort: Desc)])
  @@index([role, fullName, email, id])
  @@map("profiles")
}

model AuthSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("auth_sessions")
}

model Category {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @unique
  slug      String    @unique
  iconUrl   String?   @map("icon_url")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  products  Product[]

  @@map("categories")
}

model Product {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId            String              @map("category_id") @db.Uuid
  name                  String              @unique
  description           String?
  imageUrl              String?             @map("image_url")
  imageStoragePath      String?             @map("image_storage_path")
  price                 Decimal             @default(0) @db.Decimal(12, 2)
  oldPrice              Decimal?            @map("old_price") @db.Decimal(12, 2)
  status                ProductStatus       @default(IN_STOCK)
  stock                 Int                 @default(0)
  lowStockThreshold     Int                 @default(10) @map("low_stock_threshold")
  isActive              Boolean             @default(true) @map("is_active")
  saleMode              ProductSaleMode     @default(SIMPLE) @map("sale_mode")
  skuInventoryEnabled   Boolean             @default(false) @map("sku_inventory_enabled")
  inventoryReconciledAt DateTime?           @map("inventory_reconciled_at") @db.Timestamptz(6)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  category              Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants              ProductVariant[]
  aliases               ProductAlias[]
  skus                  ProductSku[]
  inventoryMoves        InventoryMovement[]
  reservationItems      ReservationItem[]
  wishlistItems         WishlistItem[]

  @@index([isActive, status])
  @@index([isActive, saleMode], map: "products_active_sale_mode_idx")
  @@index([isActive, name, id])
  @@map("products")
}

model ProductAlias {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  alias           String
  normalizedAlias String   @map("normalized_alias")
  source          String?
  sourceVersion   String?  @map("source_version")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, normalizedAlias])
  @@index([productId])
  @@map("product_aliases")
}

model ProductVariant {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId         String              @map("product_id") @db.Uuid
  optionName        String              @map("option_name")
  optionValue       String              @map("option_value")
  stock             Int                 @default(0)
  lowStockThreshold Int                 @default(2) @map("low_stock_threshold")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryMoves    InventoryMovement[]
  skuLinks          ProductSkuVariant[]

  @@unique([productId, optionName, optionValue])
  @@map("product_variants")
}

model ProductSku {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId         String              @map("product_id") @db.Uuid
  code              String?
  stock             Int                 @default(0)
  lowStockThreshold Int                 @default(2) @map("low_stock_threshold")
  isActive          Boolean             @default(true) @map("is_active")
  optionSnapshot    Json                @default("[]") @map("option_snapshot")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues      ProductSkuVariant[]
  reservationItems  ReservationItem[]
  inventoryMoves    InventoryMovement[]

  @@unique([productId, code])
  @@index([productId, isActive])
  @@map("product_skus")
}

model ProductSkuVariant {
  skuId     String         @map("sku_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  sku       ProductSku     @relation(fields: [skuId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([skuId, variantId])
  @@index([variantId])
  @@map("product_sku_variants")
}

model InventoryMovement {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String                @map("product_id") @db.Uuid
  variantId     String?               @map("variant_id") @db.Uuid
  skuId         String?               @map("sku_id") @db.Uuid
  type          InventoryMovementType
  quantity      Int
  previousStock Int                   @map("previous_stock")
  newStock      Int                   @map("new_stock")
  performedById String?               @map("performed_by_id") @db.Uuid
  notes         String?
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  product       Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sku           ProductSku?           @relation(fields: [skuId], references: [id], onDelete: SetNull)
  performedBy   Profile?              @relation("InventoryPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([productId, createdAt(sort: Desc)])
  @@index([variantId, createdAt(sort: Desc)])
  @@index([skuId, createdAt(sort: Desc)])
  @@map("inventory_movements")
}

model Reservation {
  id                    String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId             String                      @map("student_id") @db.Uuid
  referenceCode         String                      @unique @map("reference_code")
  status                ReservationStatus           @default(PENDING)
  pickupStart           DateTime?                   @map("pickup_start") @db.Timestamptz(6)
  pickupEnd             DateTime?                   @map("pickup_end") @db.Timestamptz(6)
  pickupPolicyVersionId String?                     @map("pickup_policy_version_id") @db.Uuid
  pickupTimeSlotId      String?                     @map("pickup_time_slot_id") @db.Uuid
  pickupReviewStatus    PickupReviewStatus          @default(NONE) @map("pickup_review_status")
  pickupReviewReason    String?                     @map("pickup_review_reason")
  scheduleRevision      Int                         @default(1) @map("schedule_revision")
  paymentMethod         PaymentMethod               @default(PAY_AT_COMMISSARY) @map("payment_method")
  checkoutPolicyVersion    String?                  @map("checkout_policy_version") @db.VarChar(32)
  checkoutPolicyAcceptedAt DateTime?                @map("checkout_policy_accepted_at") @db.Timestamptz(6)
  totalAmount           Decimal                     @default(0) @map("total_amount") @db.Decimal(12, 2)
  staffNotes            String?                     @map("staff_notes")
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                    @default(now()) @map("updated_at") @db.Timestamptz(6)
  student               Profile                     @relation("StudentReservations", fields: [studentId], references: [id], onDelete: Cascade)
  pickupPolicyVersion   PickupPolicyVersion?        @relation(fields: [pickupPolicyVersionId], references: [id], onDelete: Restrict)
  pickupTimeSlot        PickupTimeSlot?             @relation(fields: [pickupTimeSlotId], references: [id], onDelete: Restrict)
  scheduleChanges       ReservationScheduleChange[]
  items                 ReservationItem[]
  receipt               Receipt?
  offenses              StudentOffense[]
  idempotencyRequest    ReservationIdempotencyKey?
  onlinePayment         OnlinePayment?

  @@index([studentId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, pickupEnd, id])
  @@index([pickupStart, pickupEnd, status])
  @@index([pickupReviewStatus, pickupStart, id])
  @@index([pickupPolicyVersionId])
  @@index([pickupTimeSlotId])
  @@map("reservations")
}

model PolicyAcceptance {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  policyVersion String   @map("policy_version") @db.VarChar(32)
  acceptedAt    DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  user          Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, policyVersion])
  @@index([acceptedAt(sort: Desc)])
  @@map("policy_acceptances")
}

model PickupPolicyVersion {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version        Int               @unique
  timezone       String            @default("Asia/Manila")
  minAdvanceDays Int               @map("min_advance_days")
  maxAdvanceDays Int               @map("max_advance_days")
  effectiveAt    DateTime          @default(now()) @map("effective_at") @db.Timestamptz(6)
  isActive       Boolean           @default(false) @map("is_active")
  reason         String
  activationKey  String?           @unique @map("activation_key")
  createdById    String?           @map("created_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy      Profile?          @relation("PickupPolicyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  days           PickupPolicyDay[]
  timeSlots      PickupTimeSlot[]
  closures       PickupClosure[]
  reservations   Reservation[]

  @@index([isActive, effectiveAt(sort: Desc)])
  @@map("pickup_policy_versions")
}

model PickupPolicyDay {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyVersionId String              @map("policy_version_id") @db.Uuid
  weekday         Int
  enabled         Boolean             @default(true)
  policyVersion   PickupPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)

  @@unique([policyVersionId, weekday])
  @@map("pickup_policy_days")
}

model PickupTimeSlot {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyVersionId String              @map("policy_version_id") @db.Uuid
  label           String
  startMinute     Int                 @map("start_minute")
  endMinute       Int                 @map("end_minute")
  isActive        Boolean             @default(true) @map("is_active")
  sortOrder       Int                 @default(0) @map("sort_order")
  capacity        Int?
  policyVersion   PickupPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)
  reservations    Reservation[]

  @@unique([policyVersionId, startMinute, endMinute])
  @@index([policyVersionId, isActive, sortOrder])
  @@map("pickup_time_slots")
}

model PickupClosure {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyVersionId String              @map("policy_version_id") @db.Uuid
  date            DateTime            @db.Date
  reason          String
  policyVersion   PickupPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)
  scheduleChanges ReservationScheduleChange[]

  @@unique([policyVersionId, date])
  @@index([date])
  @@map("pickup_closures")
}

model ReservationScheduleChange {
  id                       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationId            String      @map("reservation_id") @db.Uuid
  actorId                  String?     @map("actor_id") @db.Uuid
  source                   ReservationScheduleChangeSource @default(MANUAL)
  closureId                String?     @map("closure_id") @db.Uuid
  triggerKey               String?     @unique @map("trigger_key")
  reason                   String
  previousPickupStart      DateTime?   @map("previous_pickup_start") @db.Timestamptz(6)
  previousPickupEnd        DateTime?   @map("previous_pickup_end") @db.Timestamptz(6)
  previousPolicyVersion    Int?        @map("previous_policy_version")
  previousSlotLabel        String?     @map("previous_slot_label")
  newPickupStart           DateTime    @map("new_pickup_start") @db.Timestamptz(6)
  newPickupEnd             DateTime    @map("new_pickup_end") @db.Timestamptz(6)
  newPolicyVersion         Int         @map("new_policy_version")
  newSlotLabel             String      @map("new_slot_label")
  previousScheduleRevision Int         @map("previous_schedule_revision")
  newScheduleRevision      Int         @map("new_schedule_revision")
  createdAt                DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  reservation              Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  actor                    Profile?    @relation("PickupScheduleChangedBy", fields: [actorId], references: [id], onDelete: SetNull)
  closure                  PickupClosure? @relation(fields: [closureId], references: [id], onDelete: SetNull)

  @@index([reservationId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([closureId, createdAt(sort: Desc)])
  @@map("reservation_schedule_changes")
}

model OnlinePayment {
  id                        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationId             String                 @unique @map("reservation_id") @db.Uuid
  status                    OnlinePaymentStatus    @default(INITIALIZING)
  amountCentavos            Int                    @map("amount_centavos")
  currency                  String                 @default("PHP") @db.Char(3)
  livemode                  Boolean                @default(false)
  providerCheckoutSessionId String?                @unique @map("provider_checkout_session_id")
  providerPaymentIntentId   String?                @unique @map("provider_payment_intent_id")
  providerPaymentId         String?                @unique @map("provider_payment_id")
  checkoutUrl               String?                @map("checkout_url")
  checkoutExpiresAt         DateTime?              @map("checkout_expires_at") @db.Timestamptz(6)
  lastReconciledAt          DateTime?              @map("last_reconciled_at") @db.Timestamptz(6)
  feeCentavos               Int?                   @map("fee_centavos")
  netAmountCentavos         Int?                   @map("net_amount_centavos")
  refundedAmountCentavos    Int                    @default(0) @map("refunded_amount_centavos")
  paidAt                    DateTime?              @map("paid_at") @db.Timestamptz(6)
  expiredAt                 DateTime?              @map("expired_at") @db.Timestamptz(6)
  cancelledAt               DateTime?              @map("cancelled_at") @db.Timestamptz(6)
  refundedAt                DateTime?              @map("refunded_at") @db.Timestamptz(6)
  createdAt                 DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  reservation               Reservation            @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  attempts                  OnlinePaymentAttempt[]
  webhookEvents             PaymongoWebhookEvent[]

  @@index([status, updatedAt])
  @@map("online_payments")
}

model OnlinePaymentAttempt {
  id                        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  onlinePaymentId           String                     @map("online_payment_id") @db.Uuid
  attemptNumber             Int                        @map("attempt_number")
  status                    OnlinePaymentAttemptStatus @default(CREATING)
  providerIdempotencyKey    String                     @unique @map("provider_idempotency_key")
  requestHash               String                     @map("request_hash") @db.Char(64)
  requestPayload            Json                       @map("request_payload")
  providerCheckoutSessionId String?                    @unique @map("provider_checkout_session_id")
  providerPaymentIntentId   String?                    @unique @map("provider_payment_intent_id")
  providerPaymentId         String?                    @unique @map("provider_payment_id")
  checkoutUrl               String?                    @map("checkout_url")
  livemode                  Boolean
  checkoutExpiresAt         DateTime?                  @map("checkout_expires_at") @db.Timestamptz(6)
  lastReconciledAt          DateTime?                  @map("last_reconciled_at") @db.Timestamptz(6)
  expireRequestedAt         DateTime?                  @map("expire_requested_at") @db.Timestamptz(6)
  expiredAt                 DateTime?                  @map("expired_at") @db.Timestamptz(6)
  providerCreatedAt         DateTime?                  @map("provider_created_at") @db.Timestamptz(6)
  paidAt                    DateTime?                  @map("paid_at") @db.Timestamptz(6)
  feeCentavos               Int?                       @map("fee_centavos")
  netAmountCentavos         Int?                       @map("net_amount_centavos")
  lastProviderErrorCode     String?                    @map("last_provider_error_code") @db.VarChar(64)
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  onlinePayment             OnlinePayment              @relation(fields: [onlinePaymentId], references: [id], onDelete: Restrict)

  @@unique([onlinePaymentId, attemptNumber])
  @@index([onlinePaymentId, status, createdAt])
  @@index([status, checkoutExpiresAt])
  @@map("online_payment_attempts")
}

model PaymongoWebhookEvent {
  id              String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerEventId String?                    @unique @map("provider_event_id")
  dedupeKey       String                     @unique @map("dedupe_key")
  eventType       String                     @map("event_type")
  livemode        Boolean
  resourceId      String?                    @map("resource_id")
  payloadHash     String                     @map("payload_hash") @db.Char(64)
  status          PaymongoWebhookEventStatus
  reasonCode      String?                    @map("reason_code") @db.VarChar(64)
  onlinePaymentId String?                    @map("online_payment_id") @db.Uuid
  receivedAt      DateTime                   @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt     DateTime                   @default(now()) @map("processed_at") @db.Timestamptz(6)
  onlinePayment   OnlinePayment?             @relation(fields: [onlinePaymentId], references: [id], onDelete: SetNull)

  @@index([eventType, receivedAt])
  @@index([onlinePaymentId, receivedAt])
  @@map("paymongo_webhook_events")
}

