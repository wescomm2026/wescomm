generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AppRole {
  STUDENT
  STAFF
  ADMIN

  @@map("app_role")
}

enum ProductStatus {
  IN_STOCK
  RESTOCK_SOON
  OUT_OF_STOCK
  ON_SALE

  @@map("product_status")
}

enum InventoryMovementType {
  RESTOCK
  SALE
  RESERVATION_HOLD
  RESERVATION_CANCEL
  RESERVATION_NO_SHOW
  ADJUSTMENT

  @@map("inventory_movement_type")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("reservation_status")
}

enum StudentOffenseType {
  NO_SHOW
  LATE_CANCELLATION
  RESERVATION_SPAM

  @@map("student_offense_type")
}

enum StudentOffenseStatus {
  ACTIVE
  OVERTURNED

  @@map("student_offense_status")
}

enum RestrictionStatus {
  ACTIVE
  EXPIRED
  LIFTED

  @@map("restriction_status")
}

enum RestrictionSource {
  AUTOMATIC
  MANUAL

  @@map("restriction_source")
}

enum PaymentMethod {
  PAY_AT_COMMISSARY
  E_WALLET_AT_PICKUP
  CASH
  GCASH

  @@map("payment_method")
}

enum ReceiptStatus {
  PENDING
  VERIFIED
  VOIDED

  @@map("receipt_status")
}

enum NotificationType {
  RESERVATION
  RECEIPT
  LOW_STOCK
  BACK_IN_STOCK
  MESSAGE
  SYSTEM

  @@map("notification_type")
}

enum ConversationStatus {
  OPEN
  RESOLVED

  @@map("conversation_status")
}

model Profile {
  id                    String                      @id @db.Uuid
  fullName              String                      @default("") @map("full_name")
  email                 String                      @unique
  studentNumber         String?                     @unique @map("student_number")
  phone                 String?
  department            String?
  address               String?
  role                  AppRole                     @default(STUDENT)
  avatarUrl             String?                     @map("avatar_url")
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                    @default(now()) @map("updated_at") @db.Timestamptz(6)
  inventoryMovements    InventoryMovement[]         @relation("InventoryPerformedBy")
  reservations          Reservation[]               @relation("StudentReservations")
  receipts              Receipt[]                   @relation("StudentReceipts")
  issuedReceipts        Receipt[]                   @relation("IssuedReceipts")
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  studentConversations  Conversation[]              @relation("StudentConversations")
  assignedConversations Conversation[]              @relation("AssignedStaffConversations")
  sentMessages          ConversationMessage[]       @relation("MessageSender")
  updatedFaqs           Faq[]                       @relation("FaqUpdatedBy")
  updatedSettings       AppSetting[]                @relation("SettingUpdatedBy")
  studentOffenses       StudentOffense[]            @relation("StudentOffenses")
  confirmedOffenses     StudentOffense[]            @relation("ConfirmedOffenses")
  overturnedOffenses    StudentOffense[]            @relation("OverturnedOffenses")
  restrictions          AccountRestriction[]        @relation("StudentRestrictions")
  createdRestrictions   AccountRestriction[]        @relation("CreatedRestrictions")
  liftedRestrictions    AccountRestriction[]        @relation("LiftedRestrictions")
  reservationRequests   ReservationIdempotencyKey[] @relation("StudentReservationRequests")
  authSessions          AuthSession[]
  wishlistItems         WishlistItem[]

  @@map("profiles")
}

model AuthSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("auth_sessions")
}

model Category {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @unique
  slug      String    @unique
  iconUrl   String?   @map("icon_url")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  products  Product[]

  @@map("categories")
}

model Product {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId        String              @map("category_id") @db.Uuid
  name              String              @unique
  description       String?
  imageUrl          String?             @map("image_url")
  price             Decimal             @default(0) @db.Decimal(12, 2)
  oldPrice          Decimal?            @map("old_price") @db.Decimal(12, 2)
  status            ProductStatus       @default(IN_STOCK)
  stock             Int                 @default(0)
  lowStockThreshold Int                 @default(10) @map("low_stock_threshold")
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  category          Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants          ProductVariant[]
  inventoryMoves    InventoryMovement[]
  reservationItems  ReservationItem[]
  wishlistItems     WishlistItem[]

  @@map("products")
}

model ProductVariant {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String              @map("product_id") @db.Uuid
  optionName     String              @map("option_name")
  optionValue    String              @map("option_value")
  stock          Int                 @default(0)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryMoves InventoryMovement[]

  @@unique([productId, optionName, optionValue])
  @@map("product_variants")
}

model InventoryMovement {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String                @map("product_id") @db.Uuid
  variantId     String?               @map("variant_id") @db.Uuid
  type          InventoryMovementType
  quantity      Int
  previousStock Int                   @map("previous_stock")
  newStock      Int                   @map("new_stock")
  performedById String?               @map("performed_by_id") @db.Uuid
  notes         String?
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  product       Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull)
  performedBy   Profile?              @relation("InventoryPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@map("inventory_movements")
}

model Reservation {
  id                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId          String                     @map("student_id") @db.Uuid
  referenceCode      String                     @unique @map("reference_code")
  status             ReservationStatus          @default(PENDING)
  pickupStart        DateTime?                  @map("pickup_start") @db.Timestamptz(6)
  pickupEnd          DateTime?                  @map("pickup_end") @db.Timestamptz(6)
  paymentMethod      PaymentMethod              @default(PAY_AT_COMMISSARY) @map("payment_method")
  totalAmount        Decimal                    @default(0) @map("total_amount") @db.Decimal(12, 2)
  staffNotes         String?                    @map("staff_notes")
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @default(now()) @map("updated_at") @db.Timestamptz(6)
  student            Profile                    @relation("StudentReservations", fields: [studentId], references: [id], onDelete: Cascade)
  items              ReservationItem[]
  receipts           Receipt[]
  offenses           StudentOffense[]
  idempotencyRequest ReservationIdempotencyKey?

  @@map("reservations")
}

model ReservationIdempotencyKey {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId     String       @map("student_id") @db.Uuid
  key           String       @map("idempotency_key")
  requestHash   String       @map("request_hash")
  reservationId String?      @unique @map("reservation_id") @db.Uuid
  expiresAt     DateTime     @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  student       Profile      @relation("StudentReservationRequests", fields: [studentId], references: [id], onDelete: Cascade)
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@unique([studentId, key])
  @@index([expiresAt])
  @@map("reservation_idempotency_keys")
}

model StudentOffense {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId      String               @map("student_id") @db.Uuid
  reservationId  String?              @map("reservation_id") @db.Uuid
  type           StudentOffenseType
  status         StudentOffenseStatus @default(ACTIVE)
  reason         String
  occurredAt     DateTime             @default(now()) @map("occurred_at") @db.Timestamptz(6)
  confirmedById  String?              @map("confirmed_by_id") @db.Uuid
  overturnedById String?              @map("overturned_by_id") @db.Uuid
  overturnedAt   DateTime?            @map("overturned_at") @db.Timestamptz(6)
  overturnReason String?              @map("overturn_reason")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  student        Profile              @relation("StudentOffenses", fields: [studentId], references: [id], onDelete: Cascade)
  reservation    Reservation?         @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  confirmedBy    Profile?             @relation("ConfirmedOffenses", fields: [confirmedById], references: [id], onDelete: SetNull)
  overturnedBy   Profile?             @relation("OverturnedOffenses", fields: [overturnedById], references: [id], onDelete: SetNull)
  restriction    AccountRestriction?

  @@unique([reservationId, type])
  @@index([studentId, status, occurredAt])
  @@map("student_offenses")
}

model AccountRestriction {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId   String            @map("student_id") @db.Uuid
  offenseId   String?           @unique @map("offense_id") @db.Uuid
  level       Int
  source      RestrictionSource
  status      RestrictionStatus @default(ACTIVE)
  reason      String
  startsAt    DateTime          @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime?         @map("ends_at") @db.Timestamptz(6)
  createdById String?           @map("created_by_id") @db.Uuid
  liftedById  String?           @map("lifted_by_id") @db.Uuid
  liftedAt    DateTime?         @map("lifted_at") @db.Timestamptz(6)
  liftReason  String?           @map("lift_reason")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  student     Profile           @relation("StudentRestrictions", fields: [studentId], references: [id], onDelete: Cascade)
  offense     StudentOffense?   @relation(fields: [offenseId], references: [id], onDelete: SetNull)
  createdBy   Profile?          @relation("CreatedRestrictions", fields: [createdById], references: [id], onDelete: SetNull)
  liftedBy    Profile?          @relation("LiftedRestrictions", fields: [liftedById], references: [id], onDelete: SetNull)

  // A partial unique index on student_id WHERE status = 'ACTIVE' is maintained
  // in SQL migrations because Prisma schema syntax cannot represent it.
  @@index([studentId, status, endsAt])
  @@index([source, level])
  @@map("account_restrictions")
}

model ReservationItem {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationId  String      @map("reservation_id") @db.Uuid
  productId      String      @map("product_id") @db.Uuid
  variantSummary String?     @map("variant_summary")
  quantity       Int
  unitPrice      Decimal     @map("unit_price") @db.Decimal(12, 2)
  subtotal       Decimal     @db.Decimal(12, 2)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  product        Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("reservation_items")
}

model Receipt {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptCode      String        @unique @map("receipt_code")
  studentId        String        @map("student_id") @db.Uuid
  reservationId    String?       @map("reservation_id") @db.Uuid
  totalAmount      Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  paymentMethod    PaymentMethod @default(CASH) @map("payment_method")
  status           ReceiptStatus @default(PENDING)
  verificationHash String        @unique @map("verification_hash")
  receiptImageUrl  String?       @map("receipt_image_url")
  receiptPdfUrl    String?       @map("receipt_pdf_url")
  issuedById       String?       @map("issued_by_id") @db.Uuid
  issuedAt         DateTime      @default(now()) @map("issued_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  student          Profile       @relation("StudentReceipts", fields: [studentId], references: [id], onDelete: Cascade)
  reservation      Reservation?  @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  issuedBy         Profile?      @relation("IssuedReceipts", fields: [issuedById], references: [id], onDelete: SetNull)

  @@map("receipts")
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  dedupeKey String?          @unique @map("dedupe_key")
  actionUrl String?          @map("action_url")
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user      Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model WishlistItem {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

model PushSubscription {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  endpoint  String    @unique
  endpointHash String? @unique @map("endpoint_hash")
  p256dh    String
  auth      String
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  user      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Conversation {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId       String                @map("student_id") @db.Uuid
  assignedStaffId String?               @map("assigned_staff_id") @db.Uuid
  subject         String
  status          ConversationStatus    @default(OPEN)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  student         Profile               @relation("StudentConversations", fields: [studentId], references: [id], onDelete: Cascade)
  assignedStaff   Profile?              @relation("AssignedStaffConversations", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  messages        ConversationMessage[]

  @@map("conversations")
}

model ConversationMessage {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  message        String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         Profile      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("conversation_messages")
}

model Faq {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question    String   @unique
  answer      String
  category    String?
  isPublished Boolean  @default(true) @map("is_published")
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy   Profile? @relation("FaqUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("faqs")
}

model AppSetting {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  value       Json     @default("{}")
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy   Profile? @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("app_settings")
}
