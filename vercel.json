{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "buildCommand": "npm run build && npm prune --omit=dev --ignore-scripts",
      "entrypoint": "app.cjs",
      "includeFiles": [
        ".vercel-bundle/**",
        "node_modules/**",
        "prisma/schema.prisma"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
