NEXT_PUBLIC_APP_ENV=development
# Local two-server development uses /api/backend. Vercel Services uses /api.
# BACKEND_API_URL is local-only; on Vercel the server guard resolves the
# current deployment URL and uses the project-level /api -> backend rewrite.
NEXT_PUBLIC_API_URL=/api/backend
BACKEND_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_AUTH_ALLOWED_EMAIL_DOMAIN=wesleyan.edu.ph

# Local or isolated Vercel Preview/QA only. Production must set this to false.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=true

# Temporary Production staff testing only. Keep false by default. When enabled,
# use the same absolute UTC expiry as the backend (maximum 24 hours). No secret
# belongs in a NEXT_PUBLIC variable.
NEXT_PUBLIC_ENABLE_TEMP_PRODUCTION_STAFF_LOGIN=false
NEXT_PUBLIC_TEMP_PRODUCTION_STAFF_LOGIN_EXPIRES_AT=

# Playwright only. Keep false for normal development and production.
NEXT_PUBLIC_E2E_TEST=false
