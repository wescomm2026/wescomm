NEXT_PUBLIC_APP_ENV=development
# Local two-server development uses /api/backend. Vercel Services uses /api.
NEXT_PUBLIC_API_URL=/api/backend
BACKEND_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_AUTH_ALLOWED_EMAIL_DOMAIN=wesleyan.edu.ph

# Development only. Production deployments must set this to false.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=true

# Playwright only. Keep false for normal development and production.
NEXT_PUBLIC_E2E_TEST=false
