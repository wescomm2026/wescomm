{
  "name": "WESCOMM",
  "short_name": "WESCOMM",
  "description": "Wesleyan Integrated Commissary Management System",
  "id": "/",
  "start_url": "/student/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#f6faf7",
  "theme_color": "#006633",
  "lang": "en-PH",
  "dir": "ltr",
  "categories": ["education", "shopping", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/wescomm-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/wescomm-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/wescomm-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Browse products",
      "short_name": "Shop",
      "description": "Browse current WESCOMM products and stock",
      "url": "/student/shop",
      "icons": [{ "src": "/icons/wescomm-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "My reservations",
      "short_name": "Reservations",
      "description": "View your WESCOMM reservations",
      "url": "/student/reservations",
      "icons": [{ "src": "/icons/wescomm-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "My receipts",
      "short_name": "Receipts",
      "description": "View your WESCOMM digital receipts",
      "url": "/student/receipts",
      "icons": [{ "src": "/icons/wescomm-icon-192.png", "sizes": "192x192" }]
    }
  ]
}
