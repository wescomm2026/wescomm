{
  "name": "wescomm-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "prebuild": "npm run style:guard && npm run copy:guard && npm run test:user-errors && npm run test:server-auth && npm run pwa:prepare",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "style:guard": "node scripts/check-style-guard.mjs",
    "copy:guard": "node scripts/check-user-facing-copy.mjs",
    "test:user-errors": "node --no-warnings scripts/test-user-facing-error.mjs",
    "test:config": "node scripts/check-next-config.mjs",
    "test:server-auth": "node scripts/test-server-api-url.mjs",
    "test:e2e": "playwright test",
    "test:e2e:release": "playwright test --config=playwright.release.config.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install chromium",
    "test:production:load": "node scripts/production-load-smoke.mjs",
    "icons:pwa": "node scripts/generate-pwa-icons.cjs",
    "pwa:prepare": "node scripts/generate-pwa-icons.cjs && node scripts/prepare-service-worker.cjs",
    "icons:vectorize": "node scripts/vectorize-icons.cjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.3.4",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@neplex/vectorizer": "^0.1.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.26",
    "sharp": "^0.35.2",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
